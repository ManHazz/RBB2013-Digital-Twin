[package]
title = "Xlerobot Digital Twin"
version = "0.1.0"
description = """A standalone (non-streaming) desktop application for the Xlerobot Digital Twin."""
keywords = ["app"]  # That makes it browsable in UI with "app" filter
template_name = "kit_base_editor"


[dependencies]
# --- XLeRobot custom extension: builds robot + scene, opens ZMQ ports 5556/5557 ---
"digitaltwin.xlerobot_extension" = {}
# "digitaltwin.satellite_extension" = {}  # left disabled — belongs to a different project

# --- Core activity / loading progress ---
"omni.activity.profiler" = {}
"omni.activity.pump" = {}

# --- Animation ---
"omni.anim.curve.core" = {}

# --- OmniGraph ---
"omni.graph.action" = {}
"omni.graph.core" = {}
"omni.graph.nodes" = {}
"omni.graph.scriptnode" = {}
"omni.graph.ui_nodes" = {}

# --- Viewport / Renderer ---
"omni.hydra.engine.stats" = {}
"omni.hydra.rtx" = {}
"omni.hydra.usdrt_delegate" = {}

# --- Kit menus ---
"omni.kit.developer.bundle" = {}
"omni.kit.mainwindow" = {}
"omni.kit.manipulator.camera" = {}
"omni.kit.manipulator.prim" = {}
"omni.kit.manipulator.selection" = {}
"omni.kit.material.library" = {}
"omni.kit.menu.common" = { order = 1000 }
"omni.kit.menu.create" = {}
"omni.kit.menu.edit" = {}
"omni.kit.menu.file" = {}
"omni.kit.primitive.mesh" = {}
"omni.kit.property.bundle" = {}
"omni.kit.raycast.query" = {}
"omni.kit.stage_template.core" = {}
"omni.kit.telemetry" = {}
"omni.kit.tool.asset_importer" = {}
"omni.kit.tool.collect" = {}
"omni.kit.viewport.legacy_gizmos" = {}
"omni.kit.viewport.menubar.camera" = {}
"omni.kit.viewport.menubar.display" = {}
"omni.kit.viewport.menubar.lighting" = {}
"omni.kit.viewport.menubar.render" = {}
"omni.kit.viewport.menubar.settings" = {}
"omni.kit.viewport.ready" = {}
"omni.kit.viewport.scene_camera_model" = {}
"omni.kit.viewport.window" = {}
"omni.kit.widget.cache_indicator" = {}
"omni.kit.window.console" = {}
"omni.kit.window.content_browser" = {}
"omni.kit.window.property" = {}
"omni.kit.window.stage" = {}
"omni.kit.window.status_bar" = {}
"omni.kit.window.toolbar" = {}

# --- Physics ---
"omni.physx.stageupdate" = {}

# --- Rendering settings & misc ---
"omni.rtx.settings.core" = {}
"omni.uiaudio" = {}
"omni.usd.metrics.assembler.ui" = {}
"omni.usd.schema.metrics.assembler" = {}
"omni.warp.core" = {}


# ---------------------------------------------------------------------------
# Persistent settings
# ---------------------------------------------------------------------------
[settings.persistent.app]
viewport.autoFrame.mode = "first_open"  # Auto-frame the robot on first open


# ---------------------------------------------------------------------------
# Runtime settings
# ---------------------------------------------------------------------------
[settings]
crashreporter.compressDumpFiles = true
exts."omni.kit.material.library".ui_show_list = ["OmniPBR", "OmniGlass", "OmniSurface", "USD Preview Surface", "OpenPBR Surface"]
exts."omni.rtx.window.settings".window_menu = "Window"
exts."omni.kit.viewport.menubar.lighting".defaultRigIgnorePattern = ""
exts."omni.kit.viewport.window".windowMenu.entryCount = 1
exts."omni.kit.viewport.window".windowMenu.label = ""
exts."omni.kit.pipapi".archiveDirs = ["/home/user/.local/share/kit-pip-envs"]
renderer.gpuEnumeration.glInterop.enabled = false
renderer.asyncInit = true
rtx.ecoMode.enabled = true
rtx.hydra.mdlMaterialWarmup = true
rtx.post.aa.op = 3            # From streaming kit — improves AA quality
rtx.verifyDriverVersion.enabled = false
telemetry.disableInternalSessionCheck = true
telemetry.enableAnonymousAppName = true
telemetry.enableAnonymousData = true
privacy.externalBuild = true


# ---------------------------------------------------------------------------
# App settings
# ---------------------------------------------------------------------------
[settings.app]
content.emptyStageOnStart = true  # Extension will load the robot USD itself
fastShutdown = true               # Cleaner exits (from streaming kit)
font.file = "${fonts}/OpenSans-SemiBold.ttf"
font.size = 16
hangDetector.enabled = true
hangDetector.timeout = 120
renderer.skipWhileMinimized = true
window.title = "Xlerobot Digital Twin"

# Use full desktop resolution — change to taste
renderer.resolution.height = 1080
renderer.resolution.width = 1920
window.height = 1080
window.width = 1920


[settings.app.environment]
name = "Xlerobot Digital Twin"


[settings.app.exts]
folders.'++' = [
    "${app}/../exts",
    "${app}/../apps",        # Included from streaming kit so digitaltwin.xlerobot_extension is found
    "${app}/../extscache/",
]


[settings.app.viewport.defaults]
fillViewport = true

[settings.app.file]
ignoreUnsavedOnExit = true   # Avoids "save?" prompt on close


# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
[[test]]
args = [
    "--/app/file/ignoreUnsavedOnExit=true"
]

[template]
type = "ApplicationTemplate"


